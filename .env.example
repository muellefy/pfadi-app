# --- Auth.js -------------------------------------------------------------
# Random secret: `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of the app (callback = $AUTH_URL/api/auth/callback/google)
AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only accounts of this Google Workspace domain may log in
ALLOWED_DOMAIN=pfadis.ch
# Use https://www.googleapis.com/auth/drive.readonly if no camp has "writeBack": true
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# --- eCamp v3 (read-only) ---------------------------------------------------
# A technical eCamp account, invited as "Gast" to every camp you want to show
ECAMP_URL=https://app.ecamp3.ch
ECAMP_EMAIL=
ECAMP_PASSWORD=

# --- Docker ------------------------------------------------------------------
PORT=3000
