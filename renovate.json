{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":timezone(Europe/Zurich)",
    "schedule:weekly",
    "group:allNonMajor"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Our own published image, not an upstream dependency",
      "matchPackageNames": ["lostiboy7/pfadi-app"],
      "enabled": false
    },
    {
      "description": "Keep the Docker base image (node) on its own PR",
      "matchDatasources": ["docker"],
      "groupName": "docker base images"
    }
  ]
}
